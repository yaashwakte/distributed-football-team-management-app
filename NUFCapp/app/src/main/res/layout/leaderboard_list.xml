<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/player_card"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        app:cardBackgroundColor="#F8F8FF"
        app:cardCornerRadius="5dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/number_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:elevation="2dp"
        android:text="numb"
        android:visibility="invisible"
        app:layout_constraintEnd_toStartOf="@id/xp_txt"
        app:layout_constraintTop_toTopOf="@+id/player_card" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4d4d4d"
        android:textSize="13sp"
        android:text=" Goals"
        android:elevation="5dp"
        app:layout_constraintStart_toEndOf="@+id/goals_txt"
        app:layout_constraintTop_toBottomOf="@id/name_txt"
        />

    <TextView
        android:id="@+id/textView6_only"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4d4d4d"
        android:textSize="13sp"
        android:text=" Assists"
        android:elevation="5dp"
        app:layout_constraintStart_toEndOf="@+id/assists_txt"
        app:layout_constraintTop_toBottomOf="@id/textView5"
        />

    <TextView
        android:id="@+id/textView7_only"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4d4d4d"
        android:textSize="13sp"
        android:text=" Saves"
        android:elevation="5dp"
        app:layout_constraintStart_toEndOf="@+id/saves_txt"
        app:layout_constraintTop_toBottomOf="@id/assists_txt"
        />

    <TextView
        android:id="@+id/saves_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:elevation="5dp"
        android:text="S"
        android:textColor="#4d4d4d"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/leaderboard_profile"
        app:layout_constraintTop_toBottomOf="@+id/assists_txt" />

    <TextView
        android:id="@+id/assists_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:elevation="5dp"
        android:text="A"
        android:textColor="#4d4d4d"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/leaderboard_profile"
        app:layout_constraintTop_toBottomOf="@+id/goals_txt" />

    <TextView
        android:id="@+id/goals_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:elevation="5dp"
        android:text="G"
        android:textColor="#4d4d4d"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/leaderboard_profile"
        app:layout_constraintTop_toBottomOf="@+id/name_txt" />

    <TextView
        android:id="@+id/name_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        android:elevation="5dp"
        android:text="Name"
        android:textColor="#4d4d4d"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/leaderboard_profile"
        app:layout_constraintTop_toTopOf="@+id/player_card" />

    <TextView
        android:id="@+id/xp_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:text="x"
        android:textColor="#228B22"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/player_card"
        app:layout_constraintEnd_toStartOf="@+id/xp_only"
        app:layout_constraintTop_toTopOf="@+id/player_card"
        app:layout_constraintVertical_bias="0.39" />

    <TextView
        android:id="@+id/xp_only"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:elevation="5dp"
        android:text=" XP"
        android:textColor="#228B22"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/player_card"
        app:layout_constraintEnd_toEndOf="@+id/player_card"
        app:layout_constraintTop_toTopOf="@+id/player_card"
        app:layout_constraintVertical_bias="0.39" />

    <TextView
        android:id="@+id/league_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:text="l"
        android:textColor="#8b0000"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/league_only"
        app:layout_constraintEnd_toStartOf="@+id/league_only" />

    <TextView
        android:id="@+id/league_only"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:elevation="5dp"
        android:text=" League"
        android:textColor="#8b0000"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/player_card"
        app:layout_constraintTop_toBottomOf="@id/xp_only" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/leaderboard_profile"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:elevation="5dp"
        android:src="@color/gray_400"
        app:layout_constraintBottom_toBottomOf="@+id/player_card"
        app:layout_constraintStart_toStartOf="@+id/player_card"
        app:layout_constraintTop_toTopOf="@+id/player_card" />

</androidx.constraintlayout.widget.ConstraintLayout>